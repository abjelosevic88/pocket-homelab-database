{
  "name": "Pocket Database",
  "short_name": "Database",
  "description": "Every database on your server: browse, query with AI help, change safely, watch for outages and growth.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#3d5a99",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "Connections", "url": "/connections" },
    { "name": "Saved queries", "url": "/saved" },
    { "name": "Changes", "url": "/activity" }
  ]
}
